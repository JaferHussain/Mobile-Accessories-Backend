{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Documents": {
    "PublicBaseUrl": "http://localhost:5080"
  },
  "Backup": {
    "ToolsDirectory": "C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin"
  }

  // ConnectionStrings:Default and Jwt:Key come from user-secrets, never from a committed file:
  //   dotnet user-secrets set "ConnectionStrings:Default" "Server=localhost;Database=moizpos;Uid=root;Pwd=...;"
  //   dotnet user-secrets set "Jwt:Key" "<at least 32 random characters>"
  //
  // PublicBaseUrl must match the port the API actually listens on (see Properties/launchSettings.json),
  // otherwise the receipt links sent to customers point nowhere.
  //
  // Backup:ToolsDirectory is only needed when mysqldump is not on PATH, which is common on a
  // developer machine. Leave it empty on a server where the MySQL client tools are installed.
}
