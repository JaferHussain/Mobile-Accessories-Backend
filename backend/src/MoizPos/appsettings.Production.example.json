{
  // TEMPLATE — copy to appsettings.Production.json and fill in the two secrets below.
  //
  // The real appsettings.Production.json holds the shop's database password and token signing
  // key, so it is listed in .gitignore and never reaches the GitHub repository. This example is
  // committed in its place so a new machine can be set up without guessing what is required.
  //
  //   copy appsettings.Production.example.json appsettings.Production.json
  //
  // Then set ASPNETCORE_ENVIRONMENT=Production and start the API. Everything it needs is in that
  // one file — no environment variables to remember.
  //
  // Settings not listed here keep the values in appsettings.json.

  "ConnectionStrings": {
    // The account the API uses. Prefer a limited account over root.
    "Default": "Server=localhost;Port=3306;Database=moizpos;Uid=moizpos_app;Pwd=<password>;AllowUserVariables=True;"
  },

  "Jwt": {
    // At least 32 characters, GENERATED at random — never a phrase someone thought up:
    //   powershell -Command "-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | %{[char]$_})"
    // Changing this signs everyone out, which is what to do if it ever leaks.
    "Key": "<at least 32 random characters>",
    "Issuer": "MoizPos",
    "Audience": "MoizPosCounter",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    // .NET merges configuration ARRAYS BY INDEX. appsettings.json has Console at index 0 and File
    // at index 1, so both are restated. Listing the File sink alone would replace Console AND
    // leave the base File sink writing to the old relative path — two log files, no console.
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          // Absolute and outside the application folder, so republishing never deletes the history.
          "path": "E:\\MoizPosData\\logs\\moizpos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        // 0.0.0.0, not localhost, so a tablet on the shop network can reach the counter app.
        // Windows Firewall must allow inbound TCP 5080 on the private profile.
        "Url": "http://0.0.0.0:5080"
      }
    }
  },

  "Cors": {
    // The EXACT origins the browser uses — scheme, host and port. Wrong values mean the browser
    // blocks every call and the screen looks broken with no error the shopkeeper can act on.
    "AllowedOrigins": [
      "http://localhost",
      "http://<this machine's LAN IP>"
    ]
  },

  "Backup": {
    // A different physical drive from MySQL's data directory. A backup on the same drive as the
    // database is lost with it.
    "Directory": "E:\\MoizPosBackups",
    "RetainDays": 30,
    "RunAtLocalHour": 2,
    // Where mysqldump lives, if it is not on PATH. Empty on a server where it is.
    "ToolsDirectory": "C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin"
  },

  "Storage": {
    // Absolute and outside the application folder: product photos are the shop's own data.
    "ProductImageRoot": "E:\\MoizPosData\\products"
  },

  "Documents": {
    // Must be reachable from a CUSTOMER's phone, which is not on the shop network. Leave empty
    // until there is such an address; the share button then explains itself instead of sending a
    // link that goes nowhere.
    "PublicBaseUrl": "",
    "ShareLinkExpiryDays": 30
  },

  "Shop": {
    "ContactNumber": ""
  },

  "AllowedHosts": "*"
}
